<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.3.0/rti_routing_service.xsd">


  <!-- 
    Set up default config ENV variables after 6.1.14. 
    Override with either ENV variables i.e. "export VAR=X" or command line -DVAR=X 
    -->
  <configuration_variables>
    <value>

      <!-- 
        This will either be the Platform or Control name depending on where this is being run 
        -->
      <element>
        <name>ROUTER_NAME</name>
        <value>VEHICLE_123</value>
      </element>

      <!-- ________________________ Domain IDS _____________________________ -->
      <!-- Domain architecture for VLAN simulation (normally physical separation):
           - ADMIN_DOMAIN: 100 (Remote administration and monitoring)
           - WAN_DOMAIN: 200 (Wide-area network between all nodes)
           - CONTROL_DOMAIN range: 10-30 (Control station local LANs)
           - PLATFORM_DOMAIN range: 30-100 (Platform node local LANs)
      -->
      <element>
        <name>ADMIN_DOMAIN</name>
        <value>100</value>
      </element>
      <element>
        <name>PLATFORM_DOMAIN</name>
        <value>30</value>
      </element>
      <element>
        <name>WAN_DOMAIN</name>
        <value>200</value>
      </element>
      <element>
        <name>CONTROL_DOMAIN</name>
        <value>10</value>
      </element>

      <!-- ________________________ QOS Profiles____________________________ -->

      <!-- 
        Generally both "sides" i.e. Platform and Control likely are using the same QoS 
        however there could be scenarios where they would be different(separate teams ownership).
        In that case, assign each side independently.
      -->

      <!-- LAN QOS -->
      <element>
        <name>PLATFORM_PARTICIPANT_QOS</name>
        <value>LAN::domain_participant_qos</value>
      </element>

      <element>
        <name>PLATFORM_EVENT_QOS</name>
        <value>LAN::event_qos</value>
      </element>

      <element>
        <name>PLATFORM_STATUS_QOS</name>
        <value>LAN::status_qos</value>
      </element>

      <element>
        <name>PLATFORM_STATUS_1SEC_QOS</name>
        <value>LAN::status_1sec_qos</value>
      </element>

      <element>
        <name>PLATFORM_STATUS_10SEC_QOS</name>
        <value>LAN::status_10sec_qos</value>
      </element>

      <element>
        <name>PLATFORM_STATUS_30SEC_QOS</name>
        <value>LAN::status_30sec_qos</value>
      </element>

      <element>
        <name>PLATFORM_STATUS_60SEC_QOS</name>
        <value>LAN::status_60sec_qos</value>
      </element>

      <element>
        <name>CONTROL_PARTICIPANT_QOS</name>
        <value>LAN::domain_participant_qos</value>
      </element>

      <element>
        <name>CONTROL_EVENT_QOS</name>
        <value>LAN::event_qos</value>
      </element>

      <element>
        <name>CONTROL_STATUS_QOS</name>
        <value>LAN::status_qos</value>
      </element>


      <!-- WAN QOS -->
      <element>
        <name>WAN_PLATFORM_PARTICIPANT_QOS</name>
        <value>WAN::platform_participant_udpv4_qos</value>
      </element>

      <element>
        <name>WAN_CONTROL_PARTICIPANT_QOS</name>
        <value>WAN::control_participant_udpv4_qos</value>
      </element>

      <element>
        <name>WAN_STATUS_QOS</name>
        <value>WAN::status_qos</value>
      </element>

      <element>
        <name>WAN_EVENT_QOS</name>
        <value>WAN::event_qos</value>
      </element>

      <element>
        <name>WAN_TEAM_QOS</name>
        <value>WAN::status_qos</value>
      </element>


      <!-- ________________________ SWITCHES _______________________________ -->
      <!-- 
        This variable enables messaging Routes between Platforms
      -->
      <element>
        <name>TEAM_ENABLE</name>
        <value>false</value>
      </element>

      <!-- 
        Enable/Disable full-rate status data transmission.
        When disabled, only primary (downsampled) status is transmitted.
        Enable on-demand for full diagnostic data.
      -->
      <element>
        <name>FULL_STATUS_ENABLE</name>
        <value>false</value>
      </element>

      <!-- 
        Enable distributed logging/monitoring. 
        Creates another DomainParticipant in ADMIN_DOMAIN that publishes
        internal log/statistic data to view in Admin Console
      -->
      <element>
        <name>DEBUG_MODE</name>
        <value>true</value>
      </element>

      <!-- 
        Enables Remote Admin Service.
        REQUEST/REPLY endpoint to update Routing Service config at runtime.
      -->
      <element>
        <name>REMOTE_ADMIN_MODE</name>
        <value>true</value>
      </element>

      <!-- 
        ___________________________DATA "CHANNELS"______________________________

        Add Topics with REGEX match to move between Control/PLATFORM 
        NOTE: No spaces in the lists or they break silently

        ___________________________DATA "CHANNELS"______________________________

        -->

      <element>
        <!-- PLATFORM -> Control Aperiodic Events/CommandAcks- Ensure Delivery (RELIABILITY QoS) -->
        <name>PLATFORM_EVENTS_CHANNEL</name>
        <value>PlatformCommandAck,ContactReport</value>
        </element>

      <element>
        <!-- PLATFORM -> Control Periodic- FULL RATE -->
        <name>PLATFORM_FULL_STATUS_CHANNEL</name>
        <value>NULL</value>
      </element>

      <element>
        <!-- 
          PLATFORM -> Control Periodic Enabled by Default - Downsampled (SAMPLE every 1 SEC)
          -->
        <name>PLATFORM_PRIMARY_STATUS_1HZ_CHANNEL</name>
        <value>PlatformStatus</value>
      </element>

      <!-- 
        Control -> PLATFORM Aperiodic- FILTER is applied
        (Content Filter that will only allow messages to the matching parentID)
        -->
      <element>
        <name>CONTROL_COMMANDS_CHANNEL</name>
        <value>ControlCommand</value>
      </element>

      <element>
        <name>CONTROL_COMMAND_FILTER_FIELD</name>
        <value>msg.destination</value>
      </element>

      <element>
        <name>CONTROL_COMMAND_FILTER_MATCH</name>
        <value>NULL</value>
      </element>

      <element>
        <name>CONTROL_EVENTS_CHANNEL</name>
        <value>ContactReport</value>
      </element>

      <!-- PLATFORM -> PLATFORM -->
      <element>
        <name>PLATFORM_TEAM_CHANNEL</name>
        <value>PlatformData</value>
      </element>
    </value>

  </configuration_variables>


  <!--
  //////////////////////////////////////////////////////////////////////////////

                   DO NOT MODIFY BELOW THIS LINE. READ-ONLY. 
  ALL CONTROL SHOULD BE DONE THROUGH THE CONFIGURATION VARIABLES ABOVE/START SCRIPT

  //////////////////////////////////////////////////////////////////////////////
  -->


  <routing_service name="control">

    <annotation>
      <documentation>
        This configuration defines message routing on the Control side.

        Sessions are created where thread pools/prioritization can be assigned.
        They can also be enabled/disabled dynamically.

        Within that are auto topic routes that generate readers and writers
        based on the *TOPICS parameters.
      </documentation>
    </annotation>

    <!-- The administration tag enables remote administration, and is
            required when using Admin Console. -->
    <administration>
      <enabled>$(REMOTE_ADMIN_MODE)</enabled>
      <domain_id>$(ADMIN_DOMAIN)</domain_id>
      <distributed_logger>
        <enabled>$(DEBUG_MODE)</enabled>
        <filter_level>WARNING</filter_level>
      </distributed_logger>
      <datareader_qos base_name="REMOTE_ADMIN::remote_admin_replier_qos" />
      <datawriter_qos base_name="REMOTE_ADMIN::remote_admin_replier_qos" />
      <domain_participant_qos>
        <participant_name>
          <name>$(ROUTER_NAME) ADMIN</name>
        </participant_name>
      </domain_participant_qos>
    </administration>

    <!-- 
      This is the Monitoring configuration for all the entities in
      this routing service, and is required when using Admin Console. 
      -->
    <monitoring>
      <enabled>$(DEBUG_MODE)</enabled>
      <!-- The domain id where to publish the monitoring information -->
      <domain_id>$(ADMIN_DOMAIN)</domain_id>
      <!-- How often to publish it -->
      <status_publication_period>
        <sec>5</sec>
        <nanosec>0</nanosec>
      </status_publication_period>

      <!-- How often to compute statistics -->
      <statistics_sampling_period>
        <sec>1</sec>
        <nanosec>0</nanosec>
      </statistics_sampling_period>
      <domain_participant_qos>
        <participant_name>
          <name>$(ROUTER_NAME) MONITOR</name>
        </participant_name>
      </domain_participant_qos>
    </monitoring>


    <domain_route name = "dr">

      <!-- Define DomainParticipants for the Control side -->
      <participant name="control_wan">
        <domain_id>$(WAN_DOMAIN)</domain_id>
        <domain_participant_qos base_name="$(WAN_CONTROL_PARTICIPANT_QOS)">
        </domain_participant_qos>
      </participant>

      <participant name="control_lan">
        <domain_id>$(CONTROL_DOMAIN)</domain_id>
        <domain_participant_qos base_name="$(CONTROL_PARTICIPANT_QOS)">
        </domain_participant_qos>
      </participant>


      <session name="control_to_wan_cmd_filter">

        <!-- Internal LAN Partition to match with ALL Publishers -->
        <subscriber_qos>
          <partition>
            <name>
              <element>*</element>
            </name>
          </partition>
        </subscriber_qos>

        <!-- External WAN Partition to match ONLY with Control Subscribers -->
        <publisher_qos>
          <partition>
            <name>
              <element>Control</element>
            </name>
          </partition>
        </publisher_qos>

        <!-- Control -> WAN Commands Filtered by Destination-->
        <auto_topic_route name="control_command_filter">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="control_lan">
            <allow_topic_name_filter>$(CONTROL_COMMANDS_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(CONTROL_EVENT_QOS)" />
          </input>
          <output participant="control_wan">
            <allow_topic_name_filter>$(CONTROL_COMMANDS_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(WAN_EVENT_QOS)" />
          </output>
        </auto_topic_route>

        <auto_topic_route name="control_events">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="control_lan">
            <allow_topic_name_filter>$(CONTROL_EVENTS_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(CONTROL_EVENT_QOS)" />
          </input>
          <output participant="control_wan">
            <allow_topic_name_filter>$(CONTROL_EVENTS_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(WAN_EVENT_QOS)" />
          </output>
        </auto_topic_route>
      </session>

      <session name="wan_to_control_status">

        <!-- External WAN Partition to match ONLY with PLATFORM Publishers -->
        <subscriber_qos>
          <partition>
            <name>
              <element>PLATFORM</element>
            </name>
          </partition>
        </subscriber_qos>

        <!-- Internal LAN Partition to match with ALL Subscribers -->
        <publisher_qos>
          <partition>
            <name>
              <element>*</element>
            </name>
          </partition>
        </publisher_qos>

        <!-- WAN -> Control Status -->
        <auto_topic_route name="platform_status_filter">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="control_wan">
            <allow_topic_name_filter>$(PLATFORM_FULL_STATUS_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(WAN_STATUS_QOS)" />
          </input>
          <output participant="control_lan">
            <allow_topic_name_filter>$(PLATFORM_FULL_STATUS_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(CONTROL_STATUS_QOS)" />
          </output>
        </auto_topic_route>

        <auto_topic_route name="platform_status_1sec_filter">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="control_wan">
            <allow_topic_name_filter>$(PLATFORM_PRIMARY_STATUS_1HZ_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(WAN_STATUS_QOS)" />
          </input>
          <output participant="control_lan">
            <allow_topic_name_filter>$(PLATFORM_PRIMARY_STATUS_1HZ_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(CONTROL_STATUS_QOS)" />
          </output>
        </auto_topic_route>

      </session>

      <!-- 
        Session moving Event data from the WAN to the Control Domain
      -->
      <session name="wan_to_control_event">

        <!-- External WAN Partition to match ONLY with PLATFORM Publishers -->
        <subscriber_qos>
          <partition>
            <name>
              <element>PLATFORM</element>
            </name>
          </partition>
        </subscriber_qos>

        <!-- Internal LAN Partition to match with ALL Subscribers -->
        <publisher_qos>
          <partition>
            <name>
              <element>*</element>
            </name>
          </partition>
        </publisher_qos>

        <!-- WAN -> Control Platform Events (Command Ack/ContactReports etc) -->
        <auto_topic_route name="platform_event_filter">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="control_wan">
            <allow_topic_name_filter>$(PLATFORM_EVENTS_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(WAN_EVENT_QOS)" />
          </input>
          <output participant="control_lan">
            <allow_topic_name_filter>$(PLATFORM_EVENTS_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(CONTROL_EVENT_QOS)" />
          </output>
        </auto_topic_route>
      </session>

    </domain_route>
  </routing_service>


  <routing_service name="platform">

    <annotation>
      <documentation>
        This configuration defines message routing on the Platform side.

        Sessions are created where thread pools/prioritization can be assigned.
        They can also be enabled/disabled dynamically.

        Within that are auto topic routes that generate readers and writers 
        based on the *TOPICS parameters.
      </documentation>
    </annotation>

    <!-- The administration tag enables remote administration, and is
            required when using Admin Console. -->
    <administration>
      <enabled>$(REMOTE_ADMIN_MODE)</enabled>
      <domain_id>$(ADMIN_DOMAIN)</domain_id>
      <distributed_logger>
        <enabled>$(DEBUG_MODE)</enabled>
        <filter_level>WARNING</filter_level>
      </distributed_logger>
      <datareader_qos base_name="REMOTE_ADMIN::remote_admin_replier_qos" />
      <datawriter_qos base_name="REMOTE_ADMIN::remote_admin_replier_qos" />
      <domain_participant_qos>
        <participant_name>
          <name>$(ROUTER_NAME) ADMIN</name>
        </participant_name>
      </domain_participant_qos>
    </administration>

    <!-- 
      This is the Monitoring configuration for all the entities in
      this routing service, and is required when using Admin Console. 
      -->
    <monitoring>
      <enabled>$(DEBUG_MODE)</enabled>
      <!-- The domain id where to publish the monitoring information -->
      <domain_id>$(ADMIN_DOMAIN)</domain_id>
      <!-- How often to publish it -->
      <status_publication_period>
        <sec>5</sec>
        <nanosec>0</nanosec>
      </status_publication_period>

      <!-- How often to compute statistics -->
      <statistics_sampling_period>
        <sec>1</sec>
        <nanosec>0</nanosec>
      </statistics_sampling_period>
      <domain_participant_qos>
        <participant_name>
          <name>$(ROUTER_NAME)-MONITOR</name>
        </participant_name>
      </domain_participant_qos>
    </monitoring>

    <domain_route name = "dr">

      <!-- Define DomainParticipants for the Platform side -->
      <participant name="platform_lan">
        <domain_id>$(PLATFORM_DOMAIN)</domain_id>
        <domain_participant_qos base_name="$(PLATFORM_PARTICIPANT_QOS)">
        </domain_participant_qos>
      </participant>

      <participant name="platform_wan">
        <domain_id>$(WAN_DOMAIN)</domain_id>
        <domain_participant_qos base_name="$(WAN_PLATFORM_PARTICIPANT_QOS)">
        </domain_participant_qos>
      </participant>

      <participant name="team_wan">
        <domain_id>$(WAN_DOMAIN)</domain_id>
        <domain_participant_qos base_name="$(WAN_PLATFORM_PARTICIPANT_QOS)">
        </domain_participant_qos>
      </participant>

      <session name="platform_to_wan_full_status" enabled="$(FULL_STATUS_ENABLE)">

        <!-- Internal LAN Partition to match with ALL Publishers -->
        <subscriber_qos>
          <partition>
            <name>
              <element>*</element>
            </name>
          </partition>
        </subscriber_qos>

        <!-- External WAN Partition to match ONLY with PLATFORM Subscribers -->
        <publisher_qos>
          <partition>
            <name>
              <element>PLATFORM</element>
            </name>
          </partition>
        </publisher_qos>

        <!-- PLATFORM -> WAN Full-rate Status messages -->
        <auto_topic_route name="platform_status_route">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="platform_lan">
            <allow_topic_name_filter>$(PLATFORM_FULL_STATUS_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(PLATFORM_STATUS_QOS)" />
          </input>
          <output participant="platform_wan">
            <allow_topic_name_filter>$(PLATFORM_FULL_STATUS_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(WAN_STATUS_QOS)" />
          </output>
        </auto_topic_route>

      </session>

      <session name="platform_to_wan_primary_status">

        <!-- Internal LAN Partition to match with ALL Publishers -->
        <subscriber_qos>
          <partition>
            <name>
              <element>*</element>
            </name>
          </partition>
        </subscriber_qos>

        <!-- External WAN Partition to match ONLY with PLATFORM Subscribers -->
        <publisher_qos>
          <partition>
            <name>
              <element>PLATFORM</element>
            </name>
          </partition>
        </publisher_qos>

        <!-- PLATFORM -> WAN Primary Status messages every 1 SEC-->
        <auto_topic_route name="platform_status_1sec_route">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="platform_lan">
            <allow_topic_name_filter>$(PLATFORM_PRIMARY_STATUS_1HZ_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(PLATFORM_STATUS_1SEC_QOS)" />
          </input>
          <output participant="platform_wan">
            <allow_topic_name_filter>$(PLATFORM_PRIMARY_STATUS_1HZ_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(WAN_STATUS_QOS)" />
          </output>
        </auto_topic_route>

      </session>

      <!-- 
        Separate Session from PlatformStatus to allow for CommandAck Prioritization 
        or Resource assignment as necessary 
      -->      
      <session name="platform_to_wan_event">

        <!-- Internal LAN Partition to match with ALL Publishers -->
        <subscriber_qos>
          <partition>
            <name>
              <element>*</element>
            </name>
          </partition>
        </subscriber_qos>

        <!-- External WAN Partition to match ONLY with PLATFORM Subscribers -->
        <publisher_qos>
          <partition>
            <name>
              <element>PLATFORM</element>
            </name>
          </partition>
        </publisher_qos>

        <!-- PLATFORM -> WAN Event messages (CommandAck/ContactReport etc) -->
        <auto_topic_route name="platform_event_route">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="platform_lan">
            <allow_topic_name_filter>$(PLATFORM_EVENTS_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(PLATFORM_EVENT_QOS)" />
          </input>
          <output participant="platform_wan">
            <allow_topic_name_filter>$(PLATFORM_EVENTS_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(PLATFORM_EVENT_QOS)" />
          </output>
        </auto_topic_route>

      </session>

      <session name="wan_to_platform">

        <!-- External WAN Partition to match ONLY with Control Publishers -->
        <subscriber_qos>
          <partition>
            <name>
              <element>Control</element>
            </name>
          </partition>
        </subscriber_qos>

        <!-- Internal LAN Partition to match with ALL Subscribers -->
        <publisher_qos>
          <partition>
            <name>
              <element>*</element>
            </name>
          </partition>
        </publisher_qos>

        <!-- WAN -> PLATFORM Commands if MATCH filter expression -->
        <auto_topic_route name="CONTROL_COMMANDS_CHANNEL">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="platform_wan">
            <allow_topic_name_filter>$(CONTROL_COMMANDS_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(WAN_EVENT_QOS)" />

            <!-- Use a SQL style syntax to filter on message content -->
            <content_filter>
              <expression>$(CONTROL_COMMAND_FILTER_FIELD) = '$(CONTROL_COMMAND_FILTER_MATCH)'</expression>
            </content_filter>
          </input>
          <output participant="platform_lan">
            <allow_topic_name_filter>$(CONTROL_COMMANDS_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(PLATFORM_EVENT_QOS)" />
          </output>
        </auto_topic_route>

        <!-- WAN -> PLATFORM Events (ContactReports etc) -->
        <auto_topic_route name="control_event">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="platform_wan">
            <allow_topic_name_filter>$(CONTROL_EVENTS_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(WAN_EVENT_QOS)" />
          </input>
          <output participant="platform_lan">
            <allow_topic_name_filter>$(CONTROL_EVENTS_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(PLATFORM_EVENT_QOS)" />
          </output>
        </auto_topic_route>

      </session>

      <!-- This session moves messages between platforms -->
      <session name="platform_to_wan_team" enabled="$(TEAM_ENABLE)">

        <!-- Using DP Partition QOS to isolate TEAM comms-->

        <!-- PLATFORM -> WAN TEAM messages -->
        <auto_topic_route name="platform_to_wan">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="platform_lan">
            <allow_topic_name_filter>$(PLATFORM_TEAM_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(PLATFORM_STATUS_QOS)" />
          </input>
          <output participant="team_wan">
            <allow_topic_name_filter>$(PLATFORM_TEAM_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(WAN_TEAM_QOS)" />
          </output>
        </auto_topic_route>
      </session>

      <!-- This session moves messages between platforms -->
      <session name="wan_to_platform_team" enabled="$(TEAM_ENABLE)">

        <!-- Using DP Partition QOS to isolate TEAM comms-->

        <!-- WAN -> PLATFORM SQUAD messages -->
        <auto_topic_route name="wan_to_platform">
          <publish_with_original_info>true</publish_with_original_info>
          <input participant="team_wan">
            <allow_topic_name_filter>$(PLATFORM_TEAM_CHANNEL)</allow_topic_name_filter>
            <datareader_qos base_name="$(WAN_TEAM_QOS)" />
          </input>
          <output participant="platform_lan">
            <allow_topic_name_filter>$(PLATFORM_TEAM_CHANNEL)</allow_topic_name_filter>
            <datawriter_qos base_name="$(PLATFORM_STATUS_QOS)" />
          </output>
        </auto_topic_route>
      </session>

    </domain_route>
  </routing_service>
</dds>